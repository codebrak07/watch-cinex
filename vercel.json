{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS, POST" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Access-Control-Expose-Headers", "value": "*" }
      ]
    },
    {
      "source": "/(.*)index_web.mpd(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS, POST" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Access-Control-Expose-Headers", "value": "*" },
        { "key": "Content-Type", "value": "application/dash+xml" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/tmdb/:path*",
      "destination": "https://api.themoviedb.org/3/:path*"
    },
    {
      "source": "/api/netmirror/:path*",
      "destination": "https://netmirror.plus/:path*"
    },
    {
      "source": "/play/index_web.mpd",
      "destination": "/api/mpd-proxy"
    },
    {
      "source": "/index_web.mpd",
      "destination": "/api/mpd-proxy"
    },
    {
      "source": "/api/index_web.mpd",
      "destination": "/api/mpd-proxy"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
